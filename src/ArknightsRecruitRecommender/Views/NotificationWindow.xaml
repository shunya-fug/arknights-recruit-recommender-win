<Window x:Class="ArknightsRecruitRecommender.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recruitment Recommendation"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight">
    <Border Background="#EE1B1F2A"
            BorderBrush="#FF4FC3F7"
            BorderThickness="1.5"
            CornerRadius="8"
            Padding="14,10">
        <StackPanel MinWidth="260" MaxWidth="360">
            <TextBlock Text="★4以上 確定タグの組み合わせ"
                       Foreground="#FF4FC3F7"
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="0,0,0,6" />
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
