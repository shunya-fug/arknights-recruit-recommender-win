<Window x:Class="ArknightsRecruitRecommender.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recruitment Recommendation"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight">
    <Border Background="#EE1B1F2A"
            BorderBrush="#FF4FC3F7"
            BorderThickness="1.5"
            CornerRadius="8"
            Padding="14,10">
        <StackPanel MinWidth="280" MaxWidth="380">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Text="★4以上 確定タグの組み合わせ"
                           Foreground="#FF4FC3F7"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="×"
                        Width="20"
                        Height="20"
                        Padding="0"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 手動チェック時のみ表示する検出タグの全件サマリ(通常の自動検出では非表示)。 -->
            <TextBlock x:Name="DebugSummaryText"
                       Foreground="#FFB0BEC5"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Visibility="Collapsed" />

            <TextBlock x:Name="NoResultsText"
                       Text="おすすめの組み合わせはありません"
                       Foreground="White"
                       FontSize="13"
                       Visibility="Collapsed" />

            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#22FFFFFF"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,3">
                            <StackPanel>
                                <Border Background="{Binding RarityBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding RarityText}"
                                               Foreground="Black"
                                               FontWeight="Bold"
                                               FontSize="12" />
                                </Border>
                                <TextBlock Text="{Binding TagsText}"
                                           Foreground="#FF4FC3F7"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,2" />
                                <TextBlock Text="{Binding OperatorsText}"
                                           Foreground="White"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
