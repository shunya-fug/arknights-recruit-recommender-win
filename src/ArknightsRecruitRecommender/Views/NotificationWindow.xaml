<Window x:Class="ArknightsRecruitRecommender.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recruitment Recommendation"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 暗色のスクロールバー(結果一覧のScrollViewerに適用される)。 -->
                <ResourceDictionary Source="DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 想定する募集時間の区間を選ぶタイムライン風セレクタの各区間(Issue #34)。区間同士は
                 隙間なく並べ、各区間の下辺に引いた線が並んで1本のタイムラインになる。上段に時間の
                 ラベル、その下に中央の値(レアリティ範囲)を表示する。区間の境目の縦の仕切り線は
                 レアリティ範囲の高さだけの短い線(BorderThickness)。選択中の区間は、線・ラベル・範囲が
                 強調色になり、線が太くなる。強調色はこのボタンのBackgroundに設定された色を使う(見逃しの警告が
                 出ている間は黄色にして、警告と色を一致させるため。
                 Background自体は他の描画には使っていない)。RadioButtonなので排他選択になる。 -->
            <Style x:Key="BandRadioStyle" TargetType="RadioButton">
                <!-- 中央のレア度表示は、時間ラベルより目立ちすぎないよう小さめ・通常の太さにし、
                     選択中の区間だけ少し太くする(Contentのテキストはこの値を継承する)。 -->
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#FFB0BEC5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderBrush" Value="#FF3A4153" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Height="36" Background="Transparent">
                                <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock x:Name="Caption"
                                               Text="{TemplateBinding Tag}"
                                               FontSize="10"
                                               Foreground="#FF78909C"
                                               HorizontalAlignment="Center" />
                                    <ContentPresenter HorizontalAlignment="Center" />
                                </StackPanel>
                                <Border Height="15"
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                <Border x:Name="Line"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="#FF3A4153" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Caption" Property="Foreground" Value="#FFB0BEC5" />
                                    <Setter TargetName="Line" Property="Background" Value="#FF78909C" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Caption" Property="Foreground" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter TargetName="Line" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Setter TargetName="Line" Property="Height" Value="2" />
                                    <Setter Property="Foreground" Value="{Binding Background, RelativeSource={RelativeSource Self}}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 既定のToolTipは白背景の素っ気ない見た目でダークテーマと衝突するため、カードと
                 揃えたスタイルに差し替える。 -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#FF1B1F2A" />
                <Setter Property="BorderBrush" Value="#FF4FC3F7" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <!-- 通知の出し入れは、このBorderのVisibility切替で行う(ウィンドウ自体はHide()しない)。
         理由はNotificationWindow.RevealNotification()のコメント参照。初期状態は非表示。 -->
    <Border x:Name="RootBorder"
            Visibility="Collapsed"
            Background="#EE1B1F2A"
            BorderBrush="#FF4FC3F7"
            BorderThickness="1.5"
            CornerRadius="8"
            Padding="14,10">
        <DockPanel MinWidth="280" MaxWidth="380" LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Text="おすすめタグ一覧"
                           Foreground="#FF4FC3F7"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="×"
                        Width="20"
                        Height="20"
                        Padding="0"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 想定する募集時間の区間(3区間を等幅で並べる)。各区間はNotificationWindow.xaml.cs
                 (BuildBandSelector)で組み立てる。 -->
            <UniformGrid x:Name="BandSelector" DockPanel.Dock="Top" Rows="1" Margin="0,0,0,8" />

            <!-- OCRで検出されたタグの一覧(自動検出・手動チェックいずれでも常に表示、Issue #26
                 Stage 1)。Foregroundはコードビハインド(UpdateDetectedTagsText)で毎回設定する
                 ためここでは指定しない(通常色/警告色どちらになるかは検出タグ数に応じて
                 実行時に決まる)。 -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetectedTagsText"
                           Grid.Column="0"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <!-- OCRの誤検出・検出漏れをユーザー自身が補正するための入口(Issue #32)。検出タグの
                     すぐ右に置き、補正の対象(検出タグ)との関係が分かるようにする。Segoe MDL2
                     Assets(Win10/11標準)の鉛筆グリフ(E70F)。アイコンだけだと用途が分かりにくい
                     ためツールチップで補う。 -->
                <Button x:Name="EditTagsButton"
                        Grid.Column="1"
                        Content="&#xE70F;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTip="タグを編集"
                        Width="20"
                        Height="20"
                        Padding="0"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="12"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        Click="EditTagsButton_Click" />
            </Grid>

            <!-- 手動でタグを補正した間、自動検出との食い違いに気づけるようにする注記(Issue #32)。
                 手動モード中のみVisibleにする(コードビハインドで切り替え)。 -->
            <Grid x:Name="ManualModeNotice" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="タグを手動選択しているため検出結果は更新されません"
                           Foreground="#FFFF5252"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <!-- Segoe MDL2 Assets(Win10/11標準)の更新グリフ(E72C)。 -->
                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="&#xE72C;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTip="自動検出に戻して更新"
                        Width="20"
                        Height="20"
                        Padding="0"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="12"
                        Cursor="Hand"
                        Click="RefreshButton_Click" />
            </Grid>

            <!-- 選択中の募集時間の区間では表示されない組み合わせが、より長い区間なら★4以上確定になる
                 場合の警告(Issue #34)。手動選択の注記の下に置く。表示は
                 NotificationWindow.xaml.cs(UpdateDetectedTagsText)で切り替える。 -->
            <TextBlock x:Name="BandHintText" DockPanel.Dock="Top"
                       Visibility="Collapsed"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />

            <!-- ★5以上確定(エリート・上級エリート)は、募集時間が9:00でないとタグが外れることがあるため、
                 表示中のカードにそれらがある場合の警告(Issue #34)。表示はRenderResultsで切り替える。 -->
            <TextBlock x:Name="NineHourHintText" DockPanel.Dock="Top"
                       Visibility="Collapsed"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />

            <!-- 組み合わせが多いと通知が画面の高さを超えて、上部(タイトル・閉じるボタン)が見えなくなるため、
                 結果の一覧だけをスクロールできるようにする(ウィンドウの最大の高さはNotificationWindow.xaml.cs
                 (ApplyPosition)で画面の作業領域に収めている)。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
            <TextBlock x:Name="NoResultsText"
                       Text="おすすめの組み合わせはありません"
                       Foreground="White"
                       FontSize="13"
                       Visibility="Collapsed" />

            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- カード全体の枠線をレアリティ色にすることで、塗りつぶしバッジより
                             主張を抑えつつ一目で判別できるようにする。ToolTipはカード全体に付与し、
                             チップが省略されていない場合も含めて常に全対象オペレーター
                             (レアリティ付き)をホバーで確認できるようにする。 -->
                        <Border Background="#22FFFFFF"
                                BorderBrush="{Binding RarityBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,3">
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="対象オペレーター"
                                                   Foreground="#FF4FC3F7"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding AllOperators}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   Foreground="White"
                                                                   FontSize="12" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding RarityLabel}"
                                                                   Foreground="{Binding RarityBrush}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Margin="10,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <StackPanel>
                                <!-- 通常表示: 「N★以上確定」ラベル行とタグ行を分けて表示する。 -->
                                <StackPanel Visibility="{Binding NormalHeaderVisibility}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding RarityText}"
                                                   Foreground="{Binding RarityBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="13" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CountText}"
                                                   Foreground="#FFB0BEC5"
                                                   FontSize="11"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                    <TextBlock Text="{Binding TagsText}"
                                               Foreground="#FF4FC3F7"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                </StackPanel>

                                <!-- コンパクト表示: 「N★以上確定」の文字ラベルは出さず、カード枠線の色と
                                     右上の件数だけでレアリティ・対象人数を示す。その分タグをヘッダー行に
                                     統合して行数を減らしている。トレイメニューから切替可能(ユーザー確認済み)。 -->
                                <Grid Visibility="{Binding CompactHeaderVisibility}" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TagsText}"
                                               Foreground="#FF4FC3F7"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CountText}"
                                               Foreground="#FFB0BEC5"
                                               FontSize="11"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Top" />
                                </Grid>

                                <!-- 対象オペレーターは1人ずつ、その人自身のレアリティ色を薄く塗った
                                     チップで表示する(「4★以上確定」でも実際には5★・6★が混ざる
                                     ことがあるため)。枠線にするとカード全体の枠線と同じ見た目になり
                                     紛らわしかった(ユーザー指摘)ため、ごく薄い塗りつぶしにしている。 -->
                                <ItemsControl ItemsSource="{Binding OperatorChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TintBrush}"
                                                    CornerRadius="3"
                                                    Padding="5,1"
                                                    Margin="0,0,4,4">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
