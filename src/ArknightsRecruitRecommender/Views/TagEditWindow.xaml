<Window x:Class="ArknightsRecruitRecommender.Views.TagEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArknightsRecruitRecommender.Views"
        Title="検出タグを編集"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1F2A"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="画面に表示されているタグに合わせてチェックを修正してください"
                   Foreground="#FF4FC3F7"
                   FontWeight="Bold"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <local:TagSelectorPanel x:Name="TagSelector" />
        </ScrollViewer>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="ClearButton"
                        Content="全解除"
                        Style="{StaticResource DarkButtonStyle}"
                        Margin="0,0,8,0"
                        Click="ClearButton_Click" />
                <Button x:Name="ResetButton"
                        Content="元に戻す"
                        Style="{StaticResource DarkButtonStyle}"
                        ToolTip="このウィンドウを開いた時点の選択状態に戻します"
                        Margin="0,0,12,0"
                        Click="ResetButton_Click" />
                <TextBlock x:Name="SelectedCountText"
                           Foreground="#FFB0BEC5"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Content="キャンセル"
                        Style="{StaticResource DarkButtonStyle}"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton"
                        Content="確定"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
