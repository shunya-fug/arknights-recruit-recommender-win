<Window x:Class="ArknightsRecruitRecommender.Views.TagEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="検出タグを編集"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1F2A">
    <Window.Resources>
        <!-- NotificationPreview(開発補助ツール)のTagToggleStyleと同じ配色に揃えている。 -->
        <Style x:Key="TagToggleStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FF2A2F3D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FF4FC3F7" />
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="画面に表示されているタグに合わせてチェックを修正してください"
                   Foreground="#FFB0BEC5"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="TagsPanel" />
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton"
                    Content="キャンセル"
                    Padding="12,5"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton"
                    Content="確定"
                    Padding="12,5"
                    Background="#FF4FC3F7"
                    Click="ConfirmButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
