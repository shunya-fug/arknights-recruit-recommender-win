<Window x:Class="NotificationPreview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ArknightsRecruitRecommender.Views;assembly=ArknightsRecruitRecommender"
        Title="通知プレビュー"
        Width="620"
        Height="760"
        Background="#FF1B1F2A">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArknightsRecruitRecommender;component/Views/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="RandomButton"
                    Content="ランダム5個"
                    Style="{StaticResource DarkButtonStyle}"
                    Margin="0,0,8,0"
                    Click="RandomButton_Click" />
            <Button x:Name="ClearButton"
                    Content="クリア"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="ClearButton_Click" />
            <TextBlock x:Name="SelectedCountText"
                       Foreground="#FFB0BEC5"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
            <CheckBox x:Name="CompactDisplayCheckBox"
                      Content="コンパクト表示"
                      Foreground="White"
                      VerticalAlignment="Center"
                      Margin="24,0,0,0"
                      Click="CompactDisplayCheckBox_Click" />
            <TextBlock Text="表示位置"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="24,0,6,0" />
            <ComboBox x:Name="PositionComboBox"
                      Width="80"
                      Background="#FF2A2F3D"
                      Foreground="White"
                      SelectionChanged="PositionComboBox_SelectionChanged" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="タグ(クリックで選択/解除)"
                   Foreground="#FF4FC3F7"
                   FontWeight="Bold"
                   Margin="0,0,0,6" />

        <ScrollViewer DockPanel.Dock="Top" MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <views:TagSelectorPanel x:Name="TagSelector" />
        </ScrollViewer>

        <TextBlock DockPanel.Dock="Top"
                   Text="判定結果(全組み合わせ。★が通知ウィンドウにも表示されるおすすめ)"
                   Foreground="#FF4FC3F7"
                   FontWeight="Bold"
                   Margin="0,16,0,6" />

        <ListBox x:Name="ResultsListBox"
                 Background="#FF12151D"
                 Foreground="White"
                 BorderThickness="0" />
    </DockPanel>
</Window>
